# ===========================================
# APP CONFIGURATION
# ===========================================
APP_NAME=SamirImperia
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
APP_SECRET="pIR6fF/H8JWPzM1JLHBfP60akc0mJooGxRMg2OHISrw="

BACKEND_DOCKERFILE="Dockerfile.dev"
APP_VOLUME=".:/app"

CONTAINER_NAME=samirimperia_app

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Supported: mysql | postgres
DB_DRIVER=postgres

DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5445
DB_NAME=samirimperia_db
DB_USER=postgres
DB_PASSWORD=samirimperia_db_pass
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h
DB_CONTAINER_NAME=samirimperia_db

# ===========================================
# ADMIN PANEL & ADMINER DASHBOARD
# ===========================================
ADMINER_PORT=8080
ADMINER_CONTAINER_NAME=samirimperia_adminer
ADMIN_PATH=/admin
ADMIN_SESSION_SECRET=samirimperia-admin-session-secret

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_ACCESS_SECRET=07eecf63301760f5f85a7fed68a5cbf31f17264f6a860831b53e4e88afab9445
JWT_REFRESH_SECRET=07eecf63301760f5f85a7fed68a5cbf31f17264f6a860831b53e4e88afab9445
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# FILE UPLOAD
# ===========================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./storage
CDN_URL=http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ===========================================
# WEBSOCKET
# ===========================================
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_PING_INTERVAL=30s
WS_PONG_TIMEOUT=60s
